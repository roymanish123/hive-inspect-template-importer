# Local development uses .data/templates.db when DATABASE_URL is empty.
# Vercel REQUIRES a persistent PostgreSQL database; local disk is not durable there.
DATABASE_URL=
# Production: random value at least 32 characters, stable across deployments.
APP_SECRET=
# Set to 1 on HTTPS deployments outside Vercel; Vercel enables this automatically.
COOKIE_SECURE=0
PORT=5000
